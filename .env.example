# Copy to .env and fill in. Never commit .env.
# SEC requires a real contact email in every request
SEC_EMAIL=you@wisc.edu

# Which Claude to use:
#   cli (default) = the local Claude Code CLI on your Claude subscription (run `claude` once to log in)
#   api           = the Anthropic API, billed per token (needs ANTHROPIC_API_KEY)
# PECORA_LLM=cli
# PECORA_CLI_MODEL=claude-sonnet-5-5
# PECORA_CLI_EFFORT=medium

# Only for PECORA_LLM=api. The CLI never sees this key: it is removed from the CLI's environment.
# ANTHROPIC_API_KEY=your_key_here
# PECORA_MODEL=claude-sonnet-5
